# Copy this file to .env and fill in your values
# cp .env.example .env

# HuggingFace token (free) — https://huggingface.co/settings/tokens
HF_TOKEN=

# Email notifications (Gmail App Password — https://myaccount.google.com/apppasswords)
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=

# FRED API key (free) — https://fred.stlouisfed.org/docs/api/api_key.html
# Provides CPI, unemployment rate, and fed funds rate data
FRED_API_KEY=
